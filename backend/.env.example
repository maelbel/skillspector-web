# self_hosted (default) or hosted. hosted refuses to start until its pieces exist (issues #41–#48).
SKILLSPECTOR_WEB_MODE=self_hosted
SKILLSPECTOR_WEB_CORS_ORIGINS=["http://localhost:3000"]
SKILLSPECTOR_WEB_MAX_CONCURRENT_SCANS=2
# Running + waiting scans; new scans get a 503 beyond this.
SKILLSPECTOR_WEB_MAX_QUEUED_SCANS=20
SKILLSPECTOR_WEB_ADMIN_TOKEN=
# Auto-delete scans older than this many days. Unset (default) keeps history forever.
SKILLSPECTOR_WEB_SCAN_RETENTION_DAYS=
