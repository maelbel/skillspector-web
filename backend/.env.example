# self_hosted (default) or hosted. hosted refuses to start while a setting it needs is missing.
SKILLSPECTOR_WEB_MODE=self_hosted
SKILLSPECTOR_WEB_CORS_ORIGINS=["http://localhost:3000"]
SKILLSPECTOR_WEB_MAX_CONCURRENT_SCANS=2
# Running + waiting scans; new scans get a 503 beyond this.
SKILLSPECTOR_WEB_MAX_QUEUED_SCANS=20
# Store scans in Postgres instead of data/scans.db (required when MODE=hosted).
SKILLSPECTOR_WEB_DATABASE_URL=
# How scans run: in_process (self_hosted default) or vercel_queues (hosted default).
SKILLSPECTOR_WEB_JOB_RUNNER=
# Live scan logs and progress: memory (self_hosted default, lost on restart) or database
# (hosted default; also keeps self-hosted logs across restarts).
SKILLSPECTOR_WEB_LOG_STORE=
# Where rate limits count requests: memory (self_hosted default, this process only) or database
# (hosted default, shared by every instance).
SKILLSPECTOR_WEB_RATE_LIMIT_STORE=
# Where scans are fetched and analysed: local (self_hosted default) or sandbox (hosted default,
# one Vercel Sandbox microVM per scan, booted from SANDBOX_SNAPSHOT_ID).
SKILLSPECTOR_WEB_SCAN_EXECUTOR=
# Build with `uv run python -m app.sandbox_snapshot`.
SKILLSPECTOR_WEB_SANDBOX_SNAPSHOT_ID=
# Who can use the server: none (self_hosted default: no sign-in, full access for anyone who can
# reach it, admin page included) or accounts (sign-in required; the first account is the admin).
SKILLSPECTOR_WEB_AUTH=
# Encrypts the Claude keys users save to their account. Generate: uv run python -m app.secrets_box
SKILLSPECTOR_WEB_SECRET_KEY=
# Password reset emails, over SMTP: they switch on when SMTP_HOST, MAIL_FROM and PUBLIC_URL are set.
SKILLSPECTOR_WEB_SMTP_HOST=
SKILLSPECTOR_WEB_SMTP_PORT=
SKILLSPECTOR_WEB_SMTP_USERNAME=
SKILLSPECTOR_WEB_SMTP_PASSWORD=
# starttls (587), ssl (465) or none (local relay only).
SKILLSPECTOR_WEB_SMTP_SECURITY=
SKILLSPECTOR_WEB_MAIL_FROM=
# This app's public address, used for links in emails, e.g. https://skillspector.example.com
SKILLSPECTOR_WEB_PUBLIC_URL=
# Auto-delete scans older than this many days. Unset (default) keeps history forever.
SKILLSPECTOR_WEB_SCAN_RETENTION_DAYS=
# Hosted only (required there), and without our prefix: Vercel Cron sends it to run the retention
# sweep. Generate: openssl rand -hex 32
CRON_SECRET=
