# Comma-separated origins allowed to call this API directly (the Nuxt server
# proxies same-origin in production, so this mostly matters for local dev).
SKILLSPECTOR_WEB_CORS_ORIGINS=["http://localhost:3000"]
SKILLSPECTOR_WEB_MAX_CONCURRENT_SCANS=2

# Optional: only needed to enable the "use LLM analysis" toggle in the UI.
# See https://github.com/NVIDIA/skillspector#readme for supported providers.
# SKILLSPECTOR_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
